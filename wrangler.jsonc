{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archivo-de-miedos",
  "main": "backend/src/index.js",
  "compatibility_date": "2025-08-08",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archivo-de-miedos-db",
      "database_id": "c12cc5c3-6d60-410b-bc21-a5adee957ffd"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": false
    }
  ]
}
